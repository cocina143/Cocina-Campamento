# ═══════════════════════════════════════════════════════════════
# CONFIGURACIÓN DE SUPABASE
# ═══════════════════════════════════════════════════════════════
# Copia este archivo como .env.local y rellena los valores
# con los datos de tu proyecto de Supabase.
#
# 1. Ve a https://supabase.com y crea un proyecto nuevo.
# 2. Ve a Settings → API
# 3. Copia "Project URL" y "anon public key"
# ═══════════════════════════════════════════════════════════════

# URL de tu proyecto Supabase (ej: https://xxxxx.supabase.co)
VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co

# Clave pública anónima de Supabase (empieza por eyJ...)
VITE_SUPABASE_ANON_KEY=eyJ...tu_clave_aqui...
